PORT=7569
NODE_ENV=production
DB_FILE=./data/planner.db
# Required on Vercel: Supabase PostgreSQL Transaction Pooler connection string.
# DATABASE_URL=
# Alternatively, Vercel Postgres provides POSTGRES_URL.
# Frontend origin; comma-separated values may include the Vercel preview URL.
CORS_ORIGIN=https://nama-frontend.vercel.app
# Optional; if omitted, the backend derives a stable secret from DATABASE_URL.
# AUTH_TOKEN_SECRET=
SEED_DEMO=false
